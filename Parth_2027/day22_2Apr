class Solution {
    public boolean isOneBitCharacter(int[] bits) {
        int i=0;
        while(i<bits.length){
            if(bits[i]==1){
                i+=2;
            }
            if(i>bits.length-1)return false;
            if(bits[i]==0){
                i++;
            }
        }
        return true;
    }
}
